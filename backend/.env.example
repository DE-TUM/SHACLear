# Copy this file to `backend/.env` and fill in the real values.
# The file `backend/.env` is git-ignored and must never be committed.

# Your OpenRouter API key. Get one at https://openrouter.ai/keys

OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Comma-separated list of origins allowed to call the API.
# Development default: the Vite dev server.
CORS_ORIGINS=http://localhost:5173
