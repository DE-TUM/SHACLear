# Repo-root example. Copy this file to `.env` and fill in the real values.
# The file `.env` is git-ignored and must never be committed.
#
# This root .env is a fallback used by scripts under `evaluation/runners/`
# (they look for `backend/.env` first, then this file). For running the app,
# use the more specific `backend/.env` and `frontend/.env` files instead.

# Your OpenRouter API key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
