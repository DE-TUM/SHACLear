{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["node"],
    // A referenced ("composite") project may not disable emit — `tsc -b`
    // rejects the whole build with TS6310 if it does. Emitting declarations
    // only, into a scratch dir under node_modules, satisfies the project-
    // reference contract without dropping a compiled vite.config.js next to
    // the source.
    "emitDeclarationOnly": true,
    "declarationDir": "./node_modules/.tmp/tsconfig-node-types",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}
